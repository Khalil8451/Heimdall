# Copy to ignored .env; generate independent random values, at least 20 characters.
# The API uses only DATABASE_URL with the restricted runtime role.
POSTGRES_ADMIN_PASSWORD=
MIGRATOR_PASSWORD=
RUNTIME_PASSWORD=
# URL-encode passwords in these local connection URLs.
ADMIN_DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL=

HOST=127.0.0.1
PORT=3000
AUTH_MODE=local
DB_STATEMENT_MS=2000
DB_CONNECT_MS=1000
SHUTDOWN_MS=5000
